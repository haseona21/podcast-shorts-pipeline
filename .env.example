# Shorts pipeline configuration.
#
# Copy this file to `.env` (same directory) and edit. Every value below is the
# DEFAULT baked into config.py — i.e. with NO .env present the pipeline produces
# the exact "winning" look, so this file documents the defaults. Uncomment and
# change only the lines you want to override. A real shell export always wins
# over a value set here.

# ---- Caption styling (caption_video.py + transcribe_captions.py) ----
SHORTS_FONT=/System/Library/Fonts/Supplemental/Georgia.ttf  # caption font (a plain .ttf path)
SHORTS_FONT_SIZE=64                 # caption glyph size in px
SHORTS_TEXT_COLOR=#F5EFE0           # cream fill color (#RRGGBB)
SHORTS_STROKE_COLOR=#F5EFE0         # stroke color; defaults to text color = no dark outline
SHORTS_STROKE_WIDTH=3               # glyph stroke width in px
SHORTS_HIGHLIGHT_COLOR=#B11226      # deep-red moving highlight box behind the active word
SHORTS_WORD_GAP=0.35                # extra inter-word gap as a fraction of a space advance
SHORTS_POSITION_Y=0.78              # caption block center as fraction of height (lower-third)
SHORTS_STACK_POSITION_Y=0.5         # caption center for stacked layout (between the two faces)
SHORTS_SHADOW_STRENGTH=0            # drop-shadow strength (0 = no shadow)
SHORTS_SHADOW_BLUR=0                # drop-shadow blur radius (0 = no shadow)
SHORTS_MAX_WORDS_PER_LINE=7         # group_words: max words per caption line
SHORTS_MAX_CHARS=32                 # group_words: max characters per caption line
SHORTS_PADDING=80                   # horizontal text bbox padding in px
SHORTS_LINE_COUNT=1                 # captacity line_count used for fit calculations
SHORTS_MAX_WORDS_PER_CAPTION=5      # max words visible at once in caption_video.py

# ---- Render geometry (render_short.py) ----
SHORTS_WIDTH=1080                   # final frame width
SHORTS_HEIGHT=1920                  # final frame height
SHORTS_FPS=24                       # output frame rate
SHORTS_CRF=18                       # x264 quality factor for cut/stack re-encodes
SHORTS_STACK_CROP_W=1215            # stacked layout: per-source center-crop width
SHORTS_STACK_CROP_H=1080            # stacked layout: per-source center-crop height
SHORTS_PANE_W=1080                  # stacked layout: scaled pane width
SHORTS_PANE_H=960                   # stacked layout: scaled pane height (two stack to HEIGHT)
